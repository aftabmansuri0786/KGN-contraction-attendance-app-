{
  "entities": {
    "Worker": {
      "title": "Worker",
      "description": "Construction worker profile managed by contractor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "category": { "type": "string" },
        "dailyWage": { "type": "number" },
        "overtimeHourlyRate": { "type": "number" },
        "joiningDate": { "type": "string" },
        "siteId": { "type": "string" },
        "isActive": { "type": "boolean" },
        "notes": { "type": "string" },
        "photoUrl": { "type": "string" },
        "photoStoragePath": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "Site": {
      "title": "Site",
      "description": "Construction site project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "startDate": { "type": "string" },
        "expectedEndDate": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance record for a worker at a site",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "siteId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "paidDayFraction": { "type": "number" },
        "dailyWageSnapshot": { "type": "number" },
        "overtimeHours": { "type": "number" },
        "overtimeRateSnapshot": { "type": "number" },
        "calculatedEarnings": { "type": "number" },
        "remarks": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "workerId", "date", "status"]
    },
    "Advance": {
      "title": "Advance",
      "description": "Cash or online advance given to worker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "reference": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "workerId", "amount", "date"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Wage settlement payment made to worker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "reference": { "type": "string" },
        "notes": { "type": "string" },
        "settlementPeriod": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "workerId", "amount", "date"]
    },
    "AmavasyaConfig": {
      "title": "AmavasyaConfig",
      "description": "Contractor selected or calculated Amavasya settlement schedule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "selectedSettlementDate": { "type": "string" },
        "isManualDate": { "type": "boolean" },
        "reminderDaysBefore": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id"]
    },
    "AmavasyaSettlement": {
      "title": "AmavasyaSettlement",
      "description": "Worker monthly Amavasya settlement statement snapshot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "periodStartDate": { "type": "string" },
        "periodEndDate": { "type": "string" },
        "presentDays": { "type": "number" },
        "halfDays": { "type": "number" },
        "absentDays": { "type": "number" },
        "paidLeaveDays": { "type": "number" },
        "payableManDays": { "type": "number" },
        "totalWages": { "type": "number" },
        "overtimeHours": { "type": "number" },
        "overtimeAmount": { "type": "number" },
        "totalEarnings": { "type": "number" },
        "previousBalance": { "type": "number" },
        "advancesTaken": { "type": "number" },
        "paymentsMade": { "type": "number" },
        "netBalance": { "type": "number" },
        "payableAmount": { "type": "number" },
        "outstandingAdvanceAmount": { "type": "number" },
        "carryForwardBalance": { "type": "number" },
        "status": { "type": "string" },
        "isLocked": { "type": "boolean" },
        "notes": { "type": "string" },
        "settledAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "workerId", "periodEndDate", "status"]
    },
    "SettlementAudit": {
      "title": "SettlementAudit",
      "description": "Audit log for Amavasya settlement completion and authorized corrections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "settlementId": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "action": { "type": "string" },
        "reason": { "type": "string" },
        "previousNetBalance": { "type": "number" },
        "newNetBalance": { "type": "number" },
        "performedBy": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "settlementId", "workerId", "action"]
    },
    "MonthlyHisabPdf": {
      "title": "MonthlyHisabPdf",
      "description": "Metadata and Firebase Storage link for generated monthly worker and combined Hisab PDFs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "year": { "type": "number" },
        "month": { "type": "number" },
        "monthLabel": { "type": "string" },
        "periodStartDate": { "type": "string" },
        "periodEndDate": { "type": "string" },
        "isCombinedReport": { "type": "boolean" },
        "storagePath": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "fileSizeBytes": { "type": "number" },
        "generatedAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "workerId", "year", "month", "periodEndDate"]
    }
  },
  "firestore": {
    "/users/{userId}/workers/{workerId}": {
      "schema": "Worker",
      "description": "Private workers collection for owner"
    },
    "/users/{userId}/sites/{siteId}": {
      "schema": "Site",
      "description": "Private sites collection for owner"
    },
    "/users/{userId}/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Private attendance records for owner"
    },
    "/users/{userId}/advances/{advanceId}": {
      "schema": "Advance",
      "description": "Private advances records for owner"
    },
    "/users/{userId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Private wage payments records for owner"
    },
    "/users/{userId}/amavasya_settings/{settingId}": {
      "schema": "AmavasyaConfig",
      "description": "Private Amavasya calendar selection for owner"
    },
    "/users/{userId}/settlements/{settlementId}": {
      "schema": "AmavasyaSettlement",
      "description": "Private monthly worker settlement statements for owner"
    },
    "/users/{userId}/settlement_audits/{auditId}": {
      "schema": "SettlementAudit",
      "description": "Private audit trail for Amavasya settlements and corrections"
    },
    "/users/{userId}/monthly_hisab_pdfs/{pdfId}": {
      "schema": "MonthlyHisabPdf",
      "description": "Private monthly Amavasya Hisab PDF reports metadata for owner"
    }
  }
}

